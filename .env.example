## Core Settings
DEBUG=true
CORS_ORIGINS=*
USE_MOCK_LLM=true
LLM_PROVIDER=openai # LLM engine : openai | gemini | grok
LEADGEN_PROVIDER=openai # Lead generation engine: google | openai | exa | tavily

## LLM Configuration

### OpenAI (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

### Google Gemini (Optional / Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

### Grok (Optional)
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning

## Lead Generation and Web Search

### Required when LEADGEN_PROVIDER=tavily
TAVILY_API_KEY=

### Required when LEADGEN_PROVIDER=exa
EXA_API_KEY=

### Required when LEADGEN_PROVIDER=google
GOOGLE_SEARCH_GROUNDING_MODEL=
GOOGLE_SEARCH_GROUNDING_FALLBACK_MODELS=
# Optional safety cap to avoid exhausting free-tier quota in one run
GOOGLE_GROUNDING_MAX_QUERIES_CAP=6

### Required when LEADGEN_PROVIDER=openai
OPENAI_SEARCH_MODEL=gpt-5-nano

## Email / Outreach Configuration
GMAIL_SMTP_KEY=
SENDER_EMAIL=

OUTREACH_SENDER_NAME=
OUTREACH_SENDER_ROLE=
OUTREACH_SENDER_COMPANY=

## Contact Discovery Settings
ENABLE_CONTACT_EMAIL_DISCOVERY=true
CONTACT_DISCOVERY_MAX_BYTES=500000


## Notes
# Set USE_MOCK_LLM=true to bypass real API calls during development.
# Ensure the selected model matches the provider and API key permissions.