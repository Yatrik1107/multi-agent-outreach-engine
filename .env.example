## Core Settings
DEBUG=true
CORS_ORIGINS=*
USE_MOCK_LLM=false
LLM_PROVIDER=openai

## LLM Configuration

### OpenAI (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

### Google Gemini (Optional / Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

### Grok (Optional)
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning

## External Services

### Web Search (Optional)
TAVILY_API_KEY=

## Email / Outreach Configuration
GMAIL_SMTP_KEY=
SENDER_EMAIL=

OUTREACH_SENDER_NAME=
OUTREACH_SENDER_ROLE=
OUTREACH_SENDER_COMPANY=

## Contact Discovery Settings
ENABLE_CONTACT_EMAIL_DISCOVERY=true
CONTACT_DISCOVERY_MAX_BYTES=500000


## Notes
# Set USE_MOCK_LLM=true to bypass real API calls during development.
# Ensure the selected model matches the provider and API key permissions.