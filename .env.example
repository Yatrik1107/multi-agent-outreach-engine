DEBUG=true
CORS_ORIGINS=*

# true = demo/mock agents and chat (no Gemini). false = live Gemini.
USE_MOCK_LLM=false

# Required when USE_MOCK_LLM=false (either name works):
GEMINI_API_KEY=
# GEMINI_API_KEY=...   # or use GOOGLE_API_KEY instead

# Required when USE_MOCK_LLM=false — must match a model your key can call:
GEMINI_MODEL=gemini-2.0-flash

# Optional but recommended for Research agent (live web snippets):
TAVILY_API_KEY=